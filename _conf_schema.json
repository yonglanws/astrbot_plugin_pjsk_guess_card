            "description": "是否启用",
            "hint": "勾选此项以启用截取区域效果"
          },
          "difficulty": {
            "type": "int",
            "default": 2,
            "description": "分数",
            "hint": "控制猜对时获得的分数"
          },
          "crop_ratio": {
            "type": "float",
            "default": 0.3,
            "description": "截取比例",
            "hint": "控制截取区域占原图的比例（0.1-0.9），值越小截取的区域越小越难猜"
          }
        }
      },
      "two_strips": {
        "description": "两长条截取效果配置",
        "type": "object",
        "default": {},
        "items": {
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "是否启用",
            "hint": "勾选此项以启用两长条截取效果"
          },
          "difficulty": {
            "type": "int",
            "default": 2,
            "description": "分数",
            "hint": "控制猜对时获得的分数"
          }
        }
      },
      "three_strips": {
        "description": "三长条截取效果配置",
        "type": "object",
        "default": {},
        "items": {
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "是否启用",
            "hint": "勾选此项以启用三长条截取效果"
          },
          "difficulty": {
            "type": "int",
            "default": 2,
            "description": "分数",
            "hint": "控制猜对时获得的分数"
          }
        }
      }
    }
  }
}