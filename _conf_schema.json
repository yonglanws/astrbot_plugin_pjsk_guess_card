{
  "default_server": {
    "description": "默认题库服务器",
    "type": "string",
    "options": [
      "jp",
      "sc"
    ],
    "default": "jp",
    "hint": "jp=日服题库（haruki-sekai-master），sc=国服题库（haruki-sekai-sc-master）。群内可用指令临时切换。"
  },
  "update_interval_hours": {
    "description": "题库自动更新间隔（小时）",
    "type": "int",
    "default": 24,
    "hint": "master 题库每 24 小时自动检查一次，仅在游戏数据版本变化时重新下载大文件。"
  },
  "connect_link_template": {
    "description": "指令连接的 markdown 模板（仅QQ官方机器人）",
    "type": "string",
    "default": "<qqbot-cmd-input text=\"{encoded_command}\" show=\"{encoded_name}\" />",
    "hint": "结算消息中连接入口的 markdown 模板（QQ 官方 markdown 参数指令标签，点击后自动在聊天框填入指令，QQ 客户端发送时自动 @ 官机）。占位符：{name}=显示名，{command}=指令原文，{self_id}=官机ID，{at_text}=@官机+指令，{encoded_name}/{encoded_command}/{encoded_at_text}=对应 URL 编码。清空该配置则退回纯文本“（连接：@官机 指令）”形式。"
  },
  "answer_timeout": {
    "description": "猜卡游戏的答题时长（秒）",
    "type": "int",
    "default": 30,
    "hint": "设置玩家回答问题的超时时间，单位为秒。"
  },
  "daily_play_limit": {
    "description": "每位玩家每日可参与猜卡的次数上限（-1表示无限制）",
    "type": "int",
    "default": 10,
    "hint": "设置每个用户每天可以玩几次猜卡游戏。设置为-1表示无限制。"
  },
  "super_users": {
    "description": "管理员用户ID列表",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [],
    "hint": "在此处添加管理员的QQ号（字符串形式），他们将有权限使用特殊指令，例如重置用户游戏次数。"
  },
  "blacklist": {
    "description": "黑名单用户ID列表",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [],
    "hint": "在此处添加被拉黑用户的QQ号（字符串形式），这些用户将无法使用猜卡功能。"
  },
  "group_whitelist": {
    "description": "群聊白名单",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [],
    "hint": "在此处添加允许使用此插件的群聊ID。如果列表为空，则所有群聊都允许使用。"
  },
  "whitelist_reject_message": {
    "description": "非白名单群聊的提示文本",
    "type": "string",
    "default": "⚠️ 抱歉，当前群聊未在白名单中，无法使用此功能。如需使用，请联系管理员将本群添加到白名单。",
    "hint": "当非白名单群聊的用户尝试触发游戏时，向其显示的提示信息。留空则不提示。"
  },
  "game_cooldown_seconds": {
    "description": "游戏冷却时间（秒）。",
    "type": "int",
    "default": 60
  },
  "max_guess_attempts": {
    "type": "int",
    "description": "每轮猜卡的最大尝试次数（-1表示无限制）",
    "default": 10,
    "hint": "设置每轮游戏中，所有玩家总共可以尝试回答的次数上限。设置为-1表示无限制。"
  },
  "ranking_display_count": {
    "description": "排行榜显示的人数",
    "type": "int",
    "default": 10,
    "hint": "设置排行榜要显示的玩家数量，建议范围：5-20"
  },
  "reward_valid_time": {
    "description": "奖励有效时间（秒）",
    "type": "int",
    "default": 5,
    "hint": "第一个玩家答对后，其他玩家在此时间内答对也能获得分数。设置为0表示禁用此功能（只有第一个答对者得分），设置为大于0的值表示启用功能并设定有效时间（单位：秒）。建议范围：3-15秒"
  },
  "effects": {
    "description": "图片效果配置",
    "type": "object",
    "default": {},
    "items": {
      "light_blur": {
        "description": "轻度模糊效果配置",
        "type": "object",
        "default": {},
        "items": {
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "是否启用",
            "hint": "勾选此项以启用轻度模糊效果"
          },
          "difficulty": {
            "type": "int",
            "default": 1,
            "description": "分数",
            "hint": "控制猜对时获得的分数"
          },
          "blur_radius": {
            "type": "int",
            "default": 25,
            "description": "模糊半径",
            "hint": "控制模糊效果的强度，值越大越模糊"
          }
        }
      },
      "heavy_blur": {
        "description": "重度模糊效果配置",
        "type": "object",
        "default": {},
        "items": {
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "是否启用",
            "hint": "勾选此项以启用重度模糊效果"
          },
          "difficulty": {
            "type": "int",
            "default": 2,
            "description": "分数",
            "hint": "控制猜对时获得的分数"
          },
          "blur_radius": {
            "type": "int",
            "default": 55,
            "description": "模糊半径",
            "hint": "控制模糊效果的强度，值越大越模糊"
          }
        }
      },
      "shuffle_blocks_easy": {
        "description": "分块打乱(简易)效果配置",
        "type": "object",
        "default": {},
        "items": {
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "是否启用",
            "hint": "勾选此项以启用分块打乱(简易)效果"
          },
          "difficulty": {
            "type": "int",
            "default": 1,
            "description": "分数",
            "hint": "控制猜对时获得的分数"
          },
          "block_size": {
            "type": "int",
            "default": 125,
            "description": "区块大小",
            "hint": "控制分块的大小，值越大区块越少"
          }
        }
      },
      "shuffle_blocks_hard": {
        "description": "分块打乱(困难)效果配置",
        "type": "object",
        "default": {},
        "items": {
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "是否启用",
            "hint": "勾选此项以启用分块打乱(困难)效果"
          },
          "difficulty": {
            "type": "int",
            "default": 3,
            "description": "分数",
            "hint": "控制猜对时获得的分数"
          },
          "block_size": {
            "type": "int",
            "default": 55,
            "description": "区块大小",
            "hint": "控制分块的大小，值越大区块越少"
          }
        }
      },
      "horizontal_slice": {
        "description": "横向切割效果配置",
        "type": "object",
        "default": {},
        "items": {
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "是否启用",
            "hint": "勾选此项以启用横向切割效果"
          },
          "difficulty": {
            "type": "int",
            "default": 1,
            "description": "分数",
            "hint": "控制猜对时获得的分数"
          },
          "slice_count": {
            "type": "int",
            "default": 45,
            "description": "切割数量",
            "hint": "控制将图片切割为多少个长条"
          }
        }
      },
      "vertical_slice": {
        "description": "纵向切割效果配置",
        "type": "object",
        "default": {},
        "items": {
          "enabled": {
            "type": "bool",
            "default": true,
            "description": "是否启用",
            "hint": "勾选此项以启用纵向切割效果"
          },
          "difficulty": {
            "type": "int",
            "default": 1,
            "description": "分数",
            "hint": "控制猜对时获得的分数"
          },
          "slice_count": {
            "type": "int",
            "default": 65,
            "description": "切割数量",
            "hint": "控制将图片切割为多少个长条"
          }
        }
      },
      "crop_area": {
        "description": "截取区域效果配置",
